{
  "java.configuration.updateBuildConfiguration": "disabled",
  "dart.runPubGetOnStartup": false,
  "dart.runPubGetOnPubspecChanges": "never",
  "java.import.gradle.wrapper.enabled": true,
  "java.import.gradle.version": "8.14.3",
